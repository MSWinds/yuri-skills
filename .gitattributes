# Normalize line endings: store as LF in the repo and check out as LF
# everywhere. Prevents spurious CRLF<->LF "changes" on Windows (e.g. after
# running npx/npm inside the repo).
* text=auto eol=lf

# Windows-only scripts keep CRLF if any are ever added.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
